{
  "name": "parametric-mineral-crystal-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Framework-agnostic procedural mineral crystal viewer",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bash -lc 'node ./node_modules/typescript/bin/tsc --build'",
    "clean": "bash -lc 'node ./node_modules/typescript/bin/tsc --build --clean'",
    "test": "bash -lc 'node ./node_modules/vitest/vitest.mjs run'",
    "check": "bash -lc 'node scripts/check-workspace.mjs && node ./node_modules/typescript/bin/tsc --build && node ./node_modules/vitest/vitest.mjs run'",
    "benchmark:m1": "bash -lc 'node ./node_modules/typescript/bin/tsc --build && node scripts/benchmark-m1.mjs'"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
