{
  "name": "parametric-mineral-crystal-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Framework-agnostic procedural mineral crystal viewer",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bash -lc 'node ./node_modules/typescript/bin/tsc --build'",
    "serve": "bash -lc 'node ./node_modules/typescript/bin/tsc --build && node ./node_modules/vite/bin/vite.js --config packages/crystal-demo/vite.config.mjs'",
    "build:demo": "bash -lc 'node ./node_modules/typescript/bin/tsc --build && node ./node_modules/vite/bin/vite.js build --config packages/crystal-demo/vite.config.mjs'",
    "build:pages": "bash -lc 'npm run build:demo && node scripts/build-pages.mjs'",
    "clean": "bash -lc 'node ./node_modules/typescript/bin/tsc --build --clean'",
    "test": "bash -lc 'node ./node_modules/vitest/vitest.mjs run'",
    "check": "bash -lc 'node scripts/check-workspace.mjs && node ./node_modules/typescript/bin/tsc --build && node ./node_modules/vitest/vitest.mjs run'",
    "benchmark:m1": "bash -lc 'node ./node_modules/typescript/bin/tsc --build && node scripts/benchmark-m1.mjs'",
    "baseline:sr0": "bash -lc 'npm run build:demo && node scripts/capture-surface-baseline.mjs'",
    "baseline:sr1": "bash -lc 'npm run build:demo && node scripts/capture-surface-baseline.mjs sr1'",
    "baseline:sr2": "bash -lc 'npm run build:demo && node scripts/capture-surface-baseline.mjs sr2'",
    "baseline:sr4": "bash -lc 'npm run build:demo && node scripts/capture-surface-baseline.mjs sr4'",
    "baseline:sr9": "bash -lc 'npm run build:demo && node scripts/capture-surface-baseline.mjs sr9'",
    "baseline:sr10": "bash -lc 'npm run build:demo && node scripts/capture-display-growth-baseline.mjs'"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "bootstrap": "^5.3.8",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
